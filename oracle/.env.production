# ============================================================================
# Environment Variables for Cinema67 Oracle Cloud Deployment
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.production .env
#   nano .env
# ============================================================================

# ── Domain ──────────────────────────────────────────────────────────────
# Set your domain. DNS must point both DOMAIN and api.DOMAIN to this VM.
DOMAIN=cinema67.it
FRONTEND_PUBLIC_BASE_URL=https://cinema67.it
CORS_ALLOWED_ORIGINS=https://cinema67.it,https://www.cinema67.it
API_BASE_URL=https://api.cinema67.it
MEDIA_BASE_URL=https://api.cinema67.it

# ── Database ────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=<SET_A_STRONG_ROOT_PASSWORD>
DB_NAME=film-api-db
DB_USER=cinebase
DB_PASSWORD=<SET_A_STRONG_DB_PASSWORD>
DB_SERVER_VERSION=10.11.0-mariadb

# ── JWT Authentication ──────────────────────────────────────────────────
JWT_SECRET=<GENERATE_WITH_openssl_rand_-hex_32>
JWT_EXPIRES_IN_DAYS=7

# ── Admin seed account ──────────────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@cinema67.it
ADMIN_SEED_PASSWORD=<SET_A_STRONG_ADMIN_PASSWORD>

# ── SMTP Email ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_REQUIRE_AUTH=true
SMTP_USER=<YOUR_EMAIL>
SMTP_PASSWORD=<GMAIL_APP_PASSWORD>
SMTP_FROM_NAME=Cinema67
SMTP_SECURE_SOCKET_OPTIONS=STARTTLS

# ── Stripe Payments ─────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=<YOUR_STRIPE_PUBLIC_KEY>
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>

# ── TMDB API ────────────────────────────────────────────────────────────
TMDB_API_KEY=<YOUR_TMDB_API_KEY>
TMDB_BEARER_TOKEN=<YOUR_TMDB_BEARER_TOKEN>

# ── OAuth (optional) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Ticket Pricing ──────────────────────────────────────────────────────
DEFAULT_TICKET_PRICE=8.50
