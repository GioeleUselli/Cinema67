# ============================================================================
# FilmAPI Dockerfile - Runtime only (pre-built)
# ============================================================================
# Backend is compiled on host: dotnet publish -c Release -o backend/publish
# ============================================================================

FROM mcr.microsoft.com/dotnet/aspnet:9.0

# Install curl for health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user (matches APP_UID convention)
RUN groupadd --gid 1654 app || true && \
    useradd --uid 1654 --gid app --create-home app || true

WORKDIR /app

# Copy pre-built publish output
COPY backend/publish .

# Set environment
ENV ASPNETCORE_URLS=http://+:8080

# Switch to non-root user
USER app

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/api/health/live || exit 1

# Entrypoint
ENTRYPOINT ["dotnet", "FilmAPI.dll"]
