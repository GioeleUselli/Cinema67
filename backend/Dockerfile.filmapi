# ============================================================================
# STAGE 1: BUILDER - Skipped, using pre-built binaries from local build
# ============================================================================
# Note: Due to .NET SDK 9.0 container assembly attribute generation issues,
# we use pre-built Release binaries from Windows build instead of building in container.
# To rebuild: Run `dotnet publish -c Release -o backend/publish` on host machine.

# ============================================================================
# STAGE 2: RUNTIME
# ============================================================================
FROM mcr.microsoft.com/dotnet/aspnet:9.0

# Install minimal runtime dependencies (Debian/apt-get)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    default-mysql-client \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user (app:app, UID 1000)
RUN groupadd -g 1000 app 2>/dev/null || true && \
    useradd -m -u 1000 -g app app 2>/dev/null || true

WORKDIR /app

# Copy published application from local pre-built directory
COPY --chown=app:app publish .

# Copy entrypoint script
COPY docker-entrypoint.sh /app/
RUN chmod +x /app/docker-entrypoint.sh

# Switch to non-root user
USER app

# Expose ports
EXPOSE 5000 8080

# Health check configuration
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Entrypoint
ENTRYPOINT ["/bin/bash", "/app/docker-entrypoint.sh"]
